{
  "debugLog": {
    "on": true,
    "path": ""
  },
  "redis": {
    "ssl": {
      "on": true,
      "certFile": "./certs/redis/ca.crt",
      "verifyCertificate": false,
      "hotReload": true
    },
    "isCluster": false,
    "host": "localhost",
    "port": "6380",
    "password": "secret",
    "database": 0,
    "prefix": "test_queue",
    "maxRetries": 2,
    "poolSize": 30,
    "minIdleConnections": 10,
    "dialTimeout": "5s",
    "readTimeout": "3s",
    "writeTimeout": "3s",
    "poolTimeout": "4s",
    "maxLen":1000
  },
  "health": {
    "port": "7777",
    "host": "0.0.0.0"
  },
  "broker": "redis",
  "consumerPoolSize": 10,
  "deadLetterIdle": "3600s",
  "jobMaxRetries": 1,
  "keepFailedJobsInHistory": "3600s",
  "keepSuccessJobsInHistory": "3600s",
  "minConsumers": 100,
  "publishTimeOut":"10s",
  "consumeTimeOut": "10s",
  "mongo": {
    "ssl": {
      "on": false,
      "certFile": "./certs/mongo/ca.pem",
      "verifyCertificate": false,
      "hotReload": true
    },
    "database": "supay_master",
    "username": "supay",
    "password": "secret",
    "host": "127.0.0.1",
    "port": "27017",
    "connectTimeout": "10s",
    "maxConnectionPoolSize": 200,
    "maxConnectionLifeTime": "600s",
    "collections": {
      "config": {
        "name": "config",
        "shard": false
      },
      "event":{
        "name": "event_logs",
        "shard": true
      },
      "opt":{
        "name": "opt_logs",
        "shard": true
      },
      "workflow": {
        "name": "workflow_records",
        "shard": true
      },
      "tenant": {
        "name": "tenants",
        "shard": false
      },
      "manager": {
        "name": "managers",
        "shard": false
      },
      "role": {
        "name": "roles",
        "shard": false
      }
    }
  },
  "history": {
    "on": true,
    "storage": "mongo"
  },
  "workflow": {
    "on": true,
    "retry": 3,
    "async": true,
    "storage": "mongo"
  }
}